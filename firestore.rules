// ==============================================================================
// FILE: firestore.rules
// PURPOSE: Declarative authorization and data validation rules for Cloud Firestore.
// LAYER: Security & Database Rules
// ARCHITECTURAL ROLE:
// Acts as the primary database-level security policy. Validates schemas and enforces 
// Role-Based Access Control (RBAC) and ownership requirements for all client-initiated 
// requests. Serves as the ultimate defense against price/inventory tampering.
// ==============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --------------------------------------------------------------------------
    // AUTHENTICATION & ACCESS CHECKS
    // --------------------------------------------------------------------------

    // SECURITY: Authenticated check.
    // Allowed: Users logged in with Firebase Authentication.
    // Denied: Anonymous/unauthenticated guests.
    function signedIn() {
      return request.auth != null;
    }

    // SECURITY: Resource ownership check.
    // Allowed: Authenticated users whose UID matches the document identifier.
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // SECURITY: Checks if the master admin configuration document exists in Firestore.
    function adminConfigExists() {
      return exists(/databases/$(database)/documents/admin_config/admins);
    }

    // SECURITY: Retrieves the static list of administrator attributes (emails, UIDs, phones).
    function adminData() {
      return get(/databases/$(database)/documents/admin_config/admins).data;
    }

    // SECURITY: Matches the current user's UID against the admin configuration records.
    function adminUidMatches() {
      return request.auth.uid in adminData().get('uids', [])
        || request.auth.uid in adminData().get('adminUids', [])
        || request.auth.uid in adminData().get('admin_uids', []);
    }

    // SECURITY: Matches the current user's email address against the admin configuration records.
    function adminEmailMatches() {
      return request.auth.token.email is string
        && (
          request.auth.token.email in adminData().get('emails', [])
          || request.auth.token.email in adminData().get('adminEmails', [])
          || request.auth.token.email in adminData().get('admin_emails', [])
        );
    }

    // SECURITY: Matches the current user's phone number against the admin configuration records.
    function adminPhoneMatches() {
      return request.auth.token.phone_number is string
        && (
          request.auth.token.phone_number in adminData().get('phones', [])
          || request.auth.token.phone_number in adminData().get('adminPhones', [])
          || request.auth.token.phone_number in adminData().get('admin_phones', [])
        );
    }

    // SECURITY: Checks custom claims inside the user's JWT auth token for administrative roles.
    function adminClaimMatches() {
      return request.auth.token.admin == true
        || request.auth.token.role == 'admin'
        || request.auth.token.role == 'owner'
        || request.auth.token.role == 'Admin'
        || request.auth.token.role == 'Owner';
    }

    // SECURITY: Verifies that a profile document for the authenticated user exists.
    function userProfileExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // SECURITY: Retrieves user profile data to check role configurations.
    function userProfileData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // SECURITY: Inspects the role field in the user's Firestore document.
    function userRoleMatches() {
      return userProfileExists()
        && (
          userProfileData().get('role', '') == 'admin'
          || userProfileData().get('role', '') == 'owner'
          || userProfileData().get('role', '') == 'Admin'
          || userProfileData().get('role', '') == 'Owner'
        );
    }

    // SECURITY: Checks if the user is suspended from performing actions.
    // Suspended users are denied write access to system functions.
    function isSuspended() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'suspended';
    }

    // SECURITY: Checks if the user is verified as an App Owner.
    function isAppOwner() {
      return signedIn()
        && !isSuspended()
        && (
          request.auth.token.role == 'owner'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'owner'
          )
        );
    }

    // SECURITY: Checks if the user is verified as an App Admin.
    function isAppAdmin() {
      return signedIn()
        && !isSuspended()
        && (
          request.auth.token.role == 'admin'
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
          )
        );
    }

    // SECURITY: Compound admin privilege evaluation check.
    // Resolves privileges through JWT claims, profiles, or static firestore admin configurations.
    function isAdmin() {
      return signedIn()
        && !isSuspended()
        && (
          adminClaimMatches()
          || userRoleMatches()
          || isAppOwner()
          || isAppAdmin()
          || (
            adminConfigExists()
            && (adminUidMatches() || adminEmailMatches() || adminPhoneMatches())
          )
        );
    }

    // --------------------------------------------------------------------------
    // SCHEMAS & UTILITY VALIDATIONS
    // --------------------------------------------------------------------------

    // BUSINESS RULE: Valid states in the life cycle of a customer order.
    function validOrderStatus(status) {
      return status in [
        'Pending',
        'Cancellation_Requested',
        'Placed',
        'Order Confirmed',
        'Packed',
        'Shipped',
        'Out for Delivery',
        'Delivered',
        'Cancelled',
      ];
    }

    // BUSINESS RULE: Validates formatting pattern of generated order identifiers.
    function validOrderId(orderId) {
      return orderId is string
        && (
          orderId.matches('^SLV-[0-9]{8}-[A-Z0-9]{4}$')
          || orderId.matches('^GK[0-9]{5,}$')
          || orderId.matches('^[a-zA-Z0-9]{20}$')
        );
    }

    // SECURITY & BUSINESS RULE: Order Creation schema and price integrity validation.
    // Client-submitted total price calculations must align with subtotal reductions and delivery fees.
    function validOrderCreate(orderId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'orderId',
          'userId',
          'userName',
          'customerName',
          'phone',
          'address',
          'pincode',
          'items',
          'originalAmount',
          'cartDiscount',
          'deliveryFee',
          'totalAmount',
          'total',
          'totalSavings',
          'searchTokens',
          'status',
          'paymentMethod',
          'createdAt',
          'timestamp',
        ])
        && data.keys().hasAll([
          'orderId',
          'userId',
          'items',
          'totalAmount',
          'total',
          'status',
          'createdAt',
          'timestamp',
        ])
        && data.orderId == orderId
        && validOrderId(orderId)
        && data.userId == request.auth.uid
        && data.status == 'Pending'
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 100
        && data.totalAmount is number
        && data.totalAmount >= 0
        && data.total is number
        && data.total == data.totalAmount
        && data.get('originalAmount', data.totalAmount) is number
        && data.get('originalAmount', data.totalAmount) >= 0
        && data.get('cartDiscount', 0) is number
        && data.get('cartDiscount', 0) >= 0
        && data.get('deliveryFee', 0) is number
        && data.get('deliveryFee', 0) >= 0
        && data.totalAmount
          == data.get('originalAmount', data.totalAmount)
            - data.get('cartDiscount', 0)
            + data.get('deliveryFee', 0)
        && data.get('totalSavings', 0) is number
        && data.get('totalSavings', 0) >= 0
        && data.get('totalSavings', 0) >= data.get('cartDiscount', 0)
        && data.get('searchTokens', []) is list
        && data.get('searchTokens', []).size() <= 120
        && data.get('userName', '') is string
        && data.get('customerName', '') is string
        && data.get('phone', '') is string
        && data.get('address', '') is string
        && data.get('pincode', '') is string
        && data.get('paymentMethod', 'COD') is string
        && data.createdAt == request.time
        && data.timestamp == request.time;
    }

    // BUSINESS RULE: Validates parameters of a single product item.
    function validProductCore() {
      let data = request.resource.data;
      return data.get('name', '') is string
        && data.get('name', '').size() > 0
        && data.get('searchName', data.get('name', '')) is string
        && data.get('searchName', data.get('name', '')).size() > 0
        && data.get('searchTokens', []) is list
        && data.get('searchTokens', []).size() <= 120
        && data.get('categoryId', data.get('category', '')) is string
        && data.get('categoryId', data.get('category', '')).size() > 0
        && data.get('price', -1) is number
        && data.get('price', -1) > 0
        && data.get('discountPrice', 0) is number
        && data.get('discountPrice', 0) >= 0
        && data.get('imageUrl', '') is string
        && data.get('isAvailable', true) is bool
        && data.get('trackStock', true) is bool
        && data.get('unit', '') is string
        && data.get('barcode', '') is string
        && data.get('barcode', '').size() <= 64
        && data.get('brand', '') is string
        && data.get('brand', '').size() <= 80
        && data.get('description', '') is string
        && data.get('description', '').size() <= 1000
        && data.get('stockQuantity', 0) is number
        && data.get('stockQuantity', 0) >= 0
        && data.get('lowStockThreshold', 5) is number
        && data.get('lowStockThreshold', 5) >= 0
        && (!data.keys().hasAny(['quantityValue']) || (data.quantityValue is number && data.quantityValue >= 0));
    }

    // BUSINESS RULE: Validates properties when a new product is created.
    function validProductCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name',
          'searchName',
          'searchTokens',
          'categoryId',
          'price',
          'discountPrice',
          'imageUrl',
          'isAvailable',
          'trackStock',
          'unit',
          'barcode',
          'brand',
          'description',
          'stockQuantity',
          'lowStockThreshold',
          'quantityValue',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'name',
          'searchName',
          'searchTokens',
          'categoryId',
          'price',
          'discountPrice',
          'imageUrl',
          'isAvailable',
          'createdAt',
          'updatedAt',
        ])
        && validProductCore()
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // BUSINESS RULE: Validates changes when product information is updated.
    function validProductUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'searchName',
          'searchTokens',
          'categoryId',
          'price',
          'discountPrice',
          'imageUrl',
          'isAvailable',
          'trackStock',
          'unit',
          'barcode',
          'brand',
          'description',
          'stockQuantity',
          'lowStockThreshold',
          'quantityValue',
          'updatedAt',
        ])
        && validProductCore()
        && request.resource.data.updatedAt == request.time;
    }

    // BUSINESS RULE: Checks the metadata fields of category documents.
    function validCategoryCore() {
      let data = request.resource.data;
      return data.get('name', '') is string
        && data.get('name', '').size() > 0
        && data.get('searchName', data.get('name', '')) is string
        && data.get('searchName', data.get('name', '')).size() > 0
        && data.get('searchTokens', []) is list
        && data.get('searchTokens', []).size() <= 80
        && data.get('imageUrl', '') is string;
    }

    // BUSINESS RULE: Ensures category fields are populated properly during creation.
    function validCategoryCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name',
          'searchName',
          'searchTokens',
          'imageUrl',
          'createdAt',
          'updatedAt',
        ])
        && data.keys().hasAll([
          'name',
          'searchName',
          'searchTokens',
          'imageUrl',
          'createdAt',
          'updatedAt',
        ])
        && validCategoryCore()
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // BUSINESS RULE: Checks properties updated on category modifications.
    function validCategoryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'searchName',
          'searchTokens',
          'imageUrl',
          'updatedAt',
        ])
        && validCategoryCore()
        && request.resource.data.updatedAt == request.time;
    }

    // SECURITY: Fields a normal customer can write to their own profile.
    function userWriteKeys() {
      return [
        'name',
        'email',
        'phone',
        'address',
        'addresses',
        'photoUrl',
        'createdAt',
        'updatedAt',
      ];
    }

    // BUSINESS RULE: Validates profile fields formatting and size thresholds.
    function validUserFields(data) {
      return data.get('name', '') is string
        && data.get('email', '') is string
        && data.get('phone', '') is string
        && data.get('address', '') is string
        && data.get('addresses', []) is list
        && data.get('addresses', []).size() <= 20
        && data.get('photoUrl', '') is string
        && data.updatedAt == request.time;
    }

    // SECURITY: Enforces default 'customer' role and 'active' status on registration.
    function validUserCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(userWriteKeys().concat(['role', 'status']))
        && validUserFields(data)
        && data.get('role', 'customer') == 'customer'
        && data.get('status', 'active') == 'active';
    }

    // SECURITY: Prevents a client from writing admin fields on update.
    function validUserUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(userWriteKeys())
        && validUserFields(request.resource.data);
    }

    // SECURITY: Validates size bounds of FCM tokens.
    function validFcmTokenId(tokenId) {
      return tokenId is string
        && tokenId.size() > 0
        && tokenId.size() <= 512;
    }

    // SECURITY: Validates fields of registered client device tokens.
    function validFcmTokenFields(data) {
      return data.get('token', '') is string
        && data.get('token', '').size() >= 20
        && data.get('token', '').size() <= 4096
        && data.get('platform', '') in [
          'android',
          'ios',
          'macos',
          'linux',
          'windows',
          'web',
          'fuchsia',
        ]
        && data.get('enabled', false) is bool
        && data.get('createdAt', request.time) is timestamp
        && data.get('updatedAt', request.time) is timestamp
        && data.get('lastSeenAt', request.time) is timestamp;
    }

    // SECURITY: Ensures system timestamps match server request time during token creation.
    function validFcmTokenCreate(tokenId) {
      let data = request.resource.data;
      return validFcmTokenId(tokenId)
        && data.keys().hasOnly([
          'token',
          'platform',
          'enabled',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
        ])
        && data.keys().hasAll([
          'token',
          'platform',
          'enabled',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
        ])
        && validFcmTokenFields(data)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.lastSeenAt == request.time;
    }

    // SECURITY: Preserves token creation date when device updates status metadata.
    function validFcmTokenCreatedAtUpdate() {
      return (
          resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == resource.data.createdAt
        )
        || (
          !resource.data.keys().hasAny(['createdAt'])
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.createdAt == request.time
        );
    }

    // SECURITY: Updates status metadata on specific tokens.
    function validFcmTokenUpdate(tokenId) {
      return validFcmTokenId(tokenId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token',
          'platform',
          'enabled',
          'createdAt',
          'updatedAt',
          'lastSeenAt',
        ])
        && validFcmTokenFields(request.resource.data)
        && validFcmTokenCreatedAtUpdate()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastSeenAt == request.time;
    }

    // BUSINESS RULE: Validates customer address constraints.
    function validAddressDocument() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'address',
          'landmark',
          'pincode',
          'isDefault',
          'createdAt',
          'updatedAt',
        ])
        && data.get('address', '') is string
        && data.get('address', '').size() >= 10
        && data.get('landmark', '') is string
        && data.get('landmark', '').size() >= 3
        && data.get('pincode', '') is string
        && data.get('pincode', '').size() == 6
        && data.get('isDefault', false) is bool
        && data.updatedAt == request.time;
    }

    // BUSINESS RULE: Prevents client side bulk wishlist overflow.
    function validWishlistWrite() {
      let data = request.resource.data;
      return data.keys().hasOnly(['productIds'])
        && data.get('productIds', []) is list
        && data.get('productIds', []).size() <= 500;
    }

    // SECURITY: Validates cart item details to prevent client-side quantity/pricing spoofing.
    function validCartItemWrite() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'name',
          'price',
          'discountPrice',
          'unit',
          'image',
          'quantity',
        ])
        && data.keys().hasAll([
          'name',
          'price',
          'discountPrice',
          'unit',
          'image',
          'quantity',
        ])
        && data.get('name', '') is string
        && data.get('price', 0) is number
        && data.get('price', 0) >= 0
        && data.get('discountPrice', 0) is number
        && data.get('discountPrice', 0) >= 0
        && data.get('unit', '') is string
        && data.get('image', '') is string
        && data.get('quantity', 0) is number
        && data.get('quantity', 0) >= 1
        && data.get('quantity', 0) <= 99;
    }

    // --------------------------------------------------------------------------
    // PATH MATCH RULES
    // --------------------------------------------------------------------------

    // RESOURCE: Users Profile and Sub-collections
    // Security Design: Owners and App Owners hold full write configurations.
    // Customers can write profile data, except role/suspension keys.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAppOwner();
      allow list: if isAppOwner();
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if (isOwner(userId) && validUserUpdate())
        || (
          isAppOwner()
          // Owner cannot change their own role to something other than owner (prevents lockout)
          && (request.auth.uid != userId || request.resource.data.get('role', 'owner') == 'owner')
          // Owner cannot suspend themselves
          && (request.auth.uid != userId || request.resource.data.get('status', 'active') == 'active')
          // Ensure role is valid
          && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['owner', 'admin', 'customer'])
          // Ensure status is valid
          && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['active', 'suspended'])
        );
      allow delete: if (isOwner(userId) && !isAppOwner()) || (isAppOwner() && request.auth.uid != userId);

      match /addresses/{addressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validAddressDocument();
        allow delete: if isOwner(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete:
            if request.auth != null
            && request.auth.uid == userId;
      }
    }

    // RESOURCE: Orders collection
    // ARCHITECTURE FLOW:
    // 1. Client creates a 'Pending' Order document.
    // 2. Client is blocked from setting status directly to 'Placed'.
    // 3. Firestore Function validates order pricing and deductions, then updates status to 'Placed'.
    // 4. Clients listen to document updates for final execution verification.
    match /orders/{orderId} {
      allow create: if signedIn() && !isSuspended() && validOrderCreate(orderId)
        && (
          !exists(/databases/$(database)/documents/store_settings/config)
          || get(/databases/$(database)/documents/store_settings/config).data.get('storeEnabled', false) == true
        );
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.userId == request.auth.uid));
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && validOrderStatus(request.resource.data.status)
        ) || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'timestamp'])
          && request.resource.data.status in ['Cancelled', 'Cancellation_Requested']
          && resource.data.status in ['Placed', 'Pending', 'Order Confirmed', 'Packed']
        );
      allow delete: if false; // Orders can never be deleted directly by clients.
    }

    // RESOURCE: Counters (Internal ID generators)
    // Security Design: Locked down completely to clients. Counter increments are executed on Backend.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // RESOURCE: Store Configuration Settings
    // Security Design: Any customer can read configured flags (e.g. storeEnabled), modifications restricted to Admins.
    match /store_settings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // RESOURCE: Notification logs
    // Security Design: Customers can read or mark as read only notifications targeting their UID. Admins manage all.
    match /notifications/{notificationId} {
      allow create: if false; // Push notifications are written only by the server-side trigger functions.
      // Customers can read their own notifications; admins can read admin-targeted ones.
      allow read: if signedIn()
        && (
          resource.data.get('targetUserId', '') == request.auth.uid
          || (isAdmin() && resource.data.get('targetRole', '') == 'admin')
          || isAdmin()
        );
      allow update: if signedIn()
        && (
          resource.data.get('targetUserId', '') == request.auth.uid
          || (isAdmin() && resource.data.get('targetRole', '') == 'admin')
          || isAdmin()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      allow delete: if false;
    }

    // RESOURCE: Catalog products
    // Security Design: Publicly readable so that customers can browse the catalog. Writes restricted to Admins.
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && validProductCreate();
      allow update: if isAdmin() && validProductUpdate();
      allow delete: if isAdmin();
    }

    // RESOURCE: Catalog categories
    // Security Design: Publicly readable for navigation. Writes restricted to Admins.
    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && validCategoryCreate();
      allow update: if isAdmin() && validCategoryUpdate();
      allow delete: if isAdmin();
    }

    // RESOURCE: Wishlists
    // Security Design: Restructured so only the specific owner of the wishlist can read/write.
    match /wishlist/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validWishlistWrite();
      allow delete: if isOwner(userId);
    }

    // RESOURCE: Shopping Carts
    // Security Design: Locked to owner profile. Writes are restricted to individual items subcollection.
    match /carts/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /items/{productId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && validCartItemWrite();
        allow delete: if isOwner(userId);
      }
    }

    // RESOURCE: Static Configuration Admin Rules list
    // Security Design: Visible only to Admins for authority checking. Clients are denied access.
    match /admin_config/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // RESOURCE: Administrative System Analytics Data
    // Security Design: Full access restricted to App Owner.
    match /system_stats/{documentId} {
      allow read, write: if isAppOwner();
    }

    // DEFAULT RETRIEVAL RULES FALLBACK
    // SECURITY: Any unmatched path is blocked by default (Closed-by-Default security posture).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
